{
  "name": "foundation-website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Public website for the scholarship and financial-aid foundation (Phase 2: static public site).",
  "scripts": {
    "build": "node src/build.mjs",
    "build:preview": "node src/build.mjs --preview",
    "build:production": "node src/build.mjs --production",
    "start": "node server/server.mjs",
    "test": "node --test --test-reporter=spec \"scripts/*.test.mjs\"",
    "check": "node scripts/check-site.mjs",
    "check:render": "node scripts/check-render.mjs",
    "check:all": "npm run build && npm test && npm run check && npm run check:render",
    "fonts": "python3 scripts/make-fonts.py",
    "brand-images": "node scripts/make-brand-images.mjs",
    "samples": "node scripts/make-sample-reports.mjs"
  },
  "dependencies": {
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=22"
  }
}
